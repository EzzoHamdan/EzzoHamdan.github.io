---
import { Font } from 'astro:assets';
import Sky from '../components/Sky.astro';
import { person, site, type Lang } from '../data/profile';
import { pageUrl, ui } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Absolute canonical URL. */
  canonical: string;
  /** Pages that exist in both languages list both here (hreflang). */
  alternates?: Partial<Record<Lang, string>>;
  ogType?: 'profile' | 'article' | 'website';
  jsonLd?: object;
  noindex?: boolean;
  /** Dim, quiet sky for long-form reading (articles). */
  calmSky?: boolean;
  /** The galaxy journey on wide screens (src/scripts/journey.ts); the profile pages only. */
  journey?: boolean;
}

const { lang, title, description, canonical, alternates, ogType = 'website', jsonLd, noindex, calmSky, journey } = Astro.props;
const strings = ui[lang];
const ogImage = new URL(`/og/${lang}.png`, site.url).href;
// Escape "<" so JSON content can never close the <script> element early
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang} dir={strings.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alternates &&
        Object.entries(alternates).map(([hreflang, href]) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))
    }
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={alternates.en} />}
    <meta name="theme-color" content="#070b1a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for AI agents (llms.txt)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={person.name[lang]} />
    <meta property="og:locale" content={strings.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name[lang]}, ${person.role[lang]}`} />
    {
      ogType === 'profile' && (
        <>
          <meta property="profile:first_name" content={person.givenName[lang]} />
          <meta property="profile:last_name" content={person.familyName[lang]} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    {
      lang === 'ar' ? (
        <>
          <Font cssVariable="--font-kufi" preload />
          <Font cssVariable="--font-text" preload={[{ subset: 'arabic', weight: 300 }]} />
        </>
      ) : (
        <>
          <Font cssVariable="--font-display" preload />
          <Font cssVariable="--font-text" preload={[{ subset: 'latin', weight: 300 }]} />
        </>
      )
    }
    {ld && <script type="application/ld+json" is:inline set:html={ld} />}
    {
      journey && (
        <script is:inline>
          // Decide before first paint, so the page never jumps from one layout to the other. Same
          // query as JOURNEY_QUERY in src/scripts/journey.ts.
          if (matchMedia('(min-width: 900px) and (min-height: 560px) and (prefers-reduced-motion: no-preference)').matches)
            document.documentElement.classList.add('journey');
        </script>
      )
    }
  </head>
  <body data-sky={calmSky ? 'calm' : undefined}>
    <a class="skip-link" href="#main">{strings.skip}</a>
    <Sky />
    <slot />
  </body>
</html>
