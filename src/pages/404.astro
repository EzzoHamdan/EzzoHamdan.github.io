---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { site } from '../data/profile';
---

<Base lang="en" title="Page not found — Ezzaldeen Hamdan" description="This page does not exist." canonical={`${site.url}/404`} noindex>
  <Header lang="en" sections={false} otherLangHref="/ar/" />
  <main id="main" class="article">
    <h1>Page not found</h1>
    <p class="prose">This address doesn't exist, or the page has moved. <a href="/">Go to the home page</a>.</p>
  </main>
</Base>
