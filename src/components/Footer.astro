---
import { person, site, type Lang } from '../data/profile';
import { formatDate, ui } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** Credit the weather data (CC BY 4.0) on pages that show Amman's weather. */
  weather?: boolean;
}

const { lang, weather = false } = Astro.props;
const year = site.updated.slice(0, 4);
---

<footer class="site-footer">
  <span>© {year} {person.name[lang]}</span>
  <span>{ui[lang].updated}: <time datetime={site.updated}>{formatDate(site.updated, lang)}</time></span>
  {
    weather && (
      <span>
        {lang === 'ar' ? 'بيانات الطقس من ' : 'Weather by '}
        <a href="https://open-meteo.com/" rel="noopener" target="_blank">Open-Meteo</a>
      </span>
    )
  }
</footer>
