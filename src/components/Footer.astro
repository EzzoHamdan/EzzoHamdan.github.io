---
import { person, site, type Lang } from '../data/profile';
import { formatDate, ui } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** Credit the weather data (CC BY 4.0) on pages that show Amman's weather. */
  weather?: boolean;
  /**
   * Lie over the foot of Amman's skyline instead of in a band of its own (global.css,
   * `.site-footer.over-city`). It is then placed inside the contact section, so it says it is the
   * page's footer with an explicit role.
   */
  overCity?: boolean;
}

const { lang, weather = false, overCity = false } = Astro.props;
const year = site.updated.slice(0, 4);
---

<footer class:list={['site-footer', { 'over-city': overCity }]} role={overCity ? 'contentinfo' : undefined}>
  <span>© {year} {person.name[lang]}</span>
  <span>{ui[lang].updated}: <time datetime={site.updated}>{formatDate(site.updated, lang)}</time></span>
  {
    weather && (
      <span>
        {lang === 'ar' ? 'بيانات الطقس من ' : 'Weather by '}
        <a href="https://open-meteo.com/" rel="noopener" target="_blank">Open-Meteo</a>
      </span>
    )
  }
</footer>
