<canvas id="sky" aria-hidden="true"></canvas>
<div class="star-label" id="star-label" aria-hidden="true" hidden></div>
<p class="sky-view" id="sky-view" aria-hidden="true" hidden></p>

<script>
  import type { SkyEvent, SkyMessage } from '../scripts/sky/renderer';
  import type { JourneyMessage } from '../scripts/sky/journey';
  import { planetNames, showers, starNames } from '../data/sky-names';
  import { PLANETS, clockOffset, night } from '../scripts/sky/astro';
  import { ammanNow, startJourney } from '../scripts/journey';
  import { latestWeather, onWeather, weatherLine } from '../scripts/weather';

  const canvas = document.getElementById('sky') as HTMLCanvasElement;
  const starLabel = document.getElementById('star-label') as HTMLElement;
  const lang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
  const calm = document.body.dataset.sky === 'calm';
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const size = () => ({ width: innerWidth, height: innerHeight, dpr: Math.min(devicePixelRatio || 1, 2) });
  // Wide screens with motion allowed fly through the galaxies (set before first paint in
  // Base.astro); everywhere else, and for reduced motion, the sky is the turning dome. The page
  // side of the journey starts right away: it lays out the scroll track.
  const journey = document.documentElement.classList.contains('journey') ? startJourney() : null;

  // What the camera is looking at, as it moves from section to section
  const viewCaption = document.getElementById('sky-view') as HTMLElement;
  const directions = {
    en: {
      overhead: 'Overhead', n: 'Looking north', ne: 'Looking northeast', e: 'Looking east', se: 'Looking southeast',
      s: 'Looking south', sw: 'Looking southwest', w: 'Looking west', nw: 'Looking northwest',
    },
    ar: {
      overhead: 'فوقنا', n: 'نحو الشمال', ne: 'نحو الشمال الشرقي', e: 'نحو الشرق', se: 'نحو الجنوب الشرقي',
      s: 'نحو الجنوب', sw: 'نحو الجنوب الغربي', w: 'نحو الغرب', nw: 'نحو الشمال الغربي',
    },
  }[lang];
  function showView(e: Extract<SkyEvent, { type: 'view' }>) {
    const body = e.kind === 'planet' ? planetNames[PLANETS[e.index]] : e.kind === 'star' ? starNames[e.index] : null;
    const name = body ? (lang === 'ar' ? body.ar : body.en) : '';
    if (e.home) {
      // Amman's clock, and its weather for this half of the day on a second line
      const w = latestWeather();
      const clock = Object.assign(document.createElement('span'), { textContent: ammanNow(lang) });
      const sky = Object.assign(document.createElement('span'), { className: 'sky-distance', textContent: w ? weatherLine(w, lang) : '' });
      viewCaption.replaceChildren(clock, sky);
      return;
    }
    viewCaption.textContent = name ? `${directions[e.direction]}: ${name}` : directions[e.direction];
  }

  function onSkyEvent(e: SkyEvent) {
    if (e.type === 'view') return showView(e);
    if (e.index < 0) {
      starLabel.hidden = true;
      return;
    }
    const planet = e.kind === 'planet';
    const body = planet ? planetNames[PLANETS[e.index]] : starNames[e.index];
    const name = document.createElement('strong');
    name.textContent = lang === 'ar' ? body.ar : body.en;
    const detail = document.createElement('span');
    if (lang === 'ar') detail.textContent = planet ? 'كوكب' : '';
    else detail.textContent = planet ? `planet, called ${body.origin} in Arabic astronomy` : `from ${body.origin}`;
    starLabel.replaceChildren(name, ...(detail.textContent ? [detail] : []));
    starLabel.style.transform = `translate(${e.x + 14}px, ${e.y - 10}px)`;
    starLabel.hidden = false;
  }

  // "The sky over Amman right now, 20:47" in the hero, kept current while the page is open
  function writeCaption() {
    const caption = document.getElementById('sky-caption');
    if (!caption) return;
    const { mode, time, shower } = night();
    const clock = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Amman', hour: '2-digit', minute: '2-digit' }).format(time);
    const lines =
      lang === 'ar'
        ? [mode === 'now' ? `سماء عمّان الآن، ${clock}` : `سماء عمّان الليلة، ${clock}`]
        : [mode === 'now' ? `The sky over Amman right now, ${clock}` : `Tonight’s sky over Amman, ${clock}`];
    const s = showers[shower];
    if (s) lines.push(lang === 'ar' ? `ذروة زخّة ${s.ar} الليلة` : `The ${s.en} meteor shower peaks tonight`);
    if (!motion.matches) {
      const touch = !matchMedia('(hover: hover)').matches;
      lines.push(
        lang === 'ar'
          ? touch ? 'المس السماء لتتمنّى أمنية' : 'انقر على السماء لتتمنّى أمنية'
          : touch ? 'Tap the sky to make a wish' : 'Click the sky to make a wish',
      );
    }
    caption.replaceChildren(...lines.map((text) => Object.assign(document.createElement('span'), { textContent: text })));
    caption.hidden = false;
  }

  type Message = SkyMessage | JourneyMessage;
  async function connect(): Promise<(msg: Message) => void> {
    const init = { ...size(), reducedMotion: motion.matches, calm, mode: journey ? 'journey' : 'dome', clockOffset: clockOffset() } as const;
    if ('transferControlToOffscreen' in canvas) {
      const worker = new Worker(new URL('../scripts/sky/worker.ts', import.meta.url), { type: 'module' });
      worker.onmessage = (event: MessageEvent<SkyEvent>) => onSkyEvent(event.data);
      const offscreen = canvas.transferControlToOffscreen();
      worker.postMessage({ type: 'init', canvas: offscreen, ...init }, [offscreen]);
      return (msg) => worker.postMessage(msg);
    }
    if (journey) {
      const { createJourney } = await import('../scripts/sky/journey');
      const sky = createJourney(canvas);
      sky.handle({ type: 'init', ...init, mode: 'journey' });
      return (msg) => sky.handle(msg as JourneyMessage);
    }
    const { createSky } = await import('../scripts/sky/renderer');
    const sky = createSky(canvas, onSkyEvent);
    sky.handle({ type: 'init', ...init });
    return (msg) => sky.handle(msg as SkyMessage);
  }

  async function start() {
    const post = await connect();
    writeCaption();
    setInterval(writeCaption, 30_000);

    let last = size();
    let resizeTimer: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const next = size();
        // Mobile browsers resize on every address-bar show/hide; only redraw on real changes
        if (next.width === last.width && next.dpr === last.dpr && Math.abs(next.height - last.height) < 120) return;
        last = next;
        post({ type: 'resize', ...next });
      }, 150);
    });

    document.addEventListener('visibilitychange', () => post({ type: 'visible', visible: !document.hidden }));
    // Amman's weather for the end of the page, only where there is an Amman to show it over
    if (document.querySelector('.skyline')) {
      onWeather((w) => {
        if (!w) return;
        const { kind: _, period: __, ...sky } = w;
        post({ type: 'weather', ...sky });
      });
    }
    motion.addEventListener('change', () => post({ type: 'motion', reduced: motion.matches }));

    // Hover names and wishes only over empty sky, so reading and links are never interrupted.
    // Controls and boxes always count as content; text blocks only where their lines actually are,
    // so the empty space beside a heading is still sky.
    const solid = 'a, button, input, svg, .card, .project, .site-header';
    const text = 'p, li, dt, dd, h1, h2, h3, h4, time';
    const onSky = (e: MouseEvent) => {
      const el = e.target as Element;
      if (el.closest?.(solid) || getSelection()?.toString()) return false;
      const block = el.closest?.(text);
      if (!block) return true;
      const range = document.createRange();
      range.selectNodeContents(block);
      return ![...range.getClientRects()].some(
        (r) => e.clientX >= r.left - 6 && e.clientX <= r.right + 6 && e.clientY >= r.top - 4 && e.clientY <= r.bottom + 4,
      );
    };
    if (journey) {
      journey.attach(post);
      // Wishes over empty space only; a content plane counts as content all over
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest?.('[data-stop="panel"]') && onSky(e)) post({ type: 'wish', x: e.clientX, y: e.clientY });
      });
      return;
    }

    // Scrolling never moves the stars; it sets how dim the sky is and how many shooting stars fall
    let ticking = false;
    // Where the skyline's far hills sit on screen now; the sky's horizon follows them exactly
    const skyline = document.querySelector<SVGSVGElement>('.skyline');
    const horizonNow = () => {
      if (!skyline) return NaN;
      // The skyline is scaled to cover and anchored at its bottom (xMidYMax slice), so map its
      // viewBox horizon line to the screen with the actual scale, not a fraction of its height
      const r = skyline.getBoundingClientRect();
      const box = skyline.viewBox.baseVal;
      const scale = Math.max(r.width / box.width, r.height / box.height);
      return r.bottom - (box.height - Number(skyline.dataset.horizon)) * scale;
    };
    // Where the contact text ends on screen now, which clouds keep below (sky/weather.ts)
    const contactWords = document.querySelector('#contact .contact');
    const textNow = () => contactWords?.getBoundingClientRect().bottom ?? NaN;
    const onScroll = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const progress = max > 0 ? Math.min(1, scrollY / max) : 0;
      post({ type: 'scroll', progress, horizonY: horizonNow(), textY: textNow() });
      // The hero has its own caption; the view caption takes over once the journey starts
      viewCaption.hidden = calm || progress < 0.06 || !viewCaption.textContent;
    };
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(onScroll);
      },
      { passive: true },
    );
    onScroll();

    // Tell the sky where each section begins along the scroll (in pixels), so the camera can hold
    // a shot per section and move between them at an even pace
    const sendScenes = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (max <= 0) return;
      const anchors = [...document.querySelectorAll<HTMLElement>('main > section[id]')].map((el) => {
        // A section's shot is reached as its heading comes into view, 30% down the screen
        const top = el.getBoundingClientRect().top + scrollY;
        return { id: el.id, at: Math.min(max, Math.max(0, top - innerHeight * 0.3)) };
      });
      post({ type: 'scenes', anchors, max, vh: innerHeight });
      onScroll();
    };
    sendScenes();
    document.fonts.ready.then(sendScenes);
    new ResizeObserver(() => sendScenes()).observe(document.body);

    if (matchMedia('(hover: hover)').matches) {
      document.addEventListener('pointermove', (e) => {
        if (onSky(e)) post({ type: 'pointer', x: e.clientX, y: e.clientY });
        else post({ type: 'pointer-leave' });
      });
      document.addEventListener('pointerleave', () => post({ type: 'pointer-leave' }));
    }
    if (!calm) {
      document.addEventListener('click', (e) => {
        if (onSky(e)) post({ type: 'wish', x: e.clientX, y: e.clientY });
      });
    }
  }

  // Wait until the page has painted so the sky never competes with the content
  if ('requestIdleCallback' in window) requestIdleCallback(() => void start(), { timeout: 1200 });
  else setTimeout(() => void start(), 200);
</script>
