---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Council from './Council.astro';
import Skyline from './Skyline.astro';
import Icon from './Icon.astro';
import {
  certifications,
  degrees,
  experience,
  highlights,
  orgs,
  person,
  projects,
  site,
  type Lang,
} from '../data/profile';
import { formatMonth, formatPeriod, pageUrl, t, tag, ui } from '../lib/i18n';
import { profileGraph } from '../lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const title =
  lang === 'en'
    ? `${person.name.en} — ${person.role.en} in ${person.location.en}`
    : `${person.name.ar} — ${person.role.ar} في ${person.location.ar}`;
const roleLine = lang === 'en' ? `AI engineer in ${person.location.en}` : `${person.role.ar} في ${person.location.ar}`;
const and = lang === 'en' ? ' and ' : ' و';
const comma = lang === 'en' ? ', ' : '، ';
const orgNames = (keys: (keyof typeof orgs)[]) => keys.map((k) => t(orgs[k].name, lang)).join(and);
const current = experience.find((r) => r.end === null)!;
const previous = experience.filter((r) => r.end !== null);
// On wide screens (the galaxy journey) a role shows two highlights per group until expanded
const SHOWN = 2;
const hidden = (role: (typeof experience)[number]) =>
  (role.groups ?? []).reduce((n, g) => n + Math.max(0, t(g.bullets, lang).length - SHOWN), 0);
// Each organization's color, for the glow of its logo planet
const BRAND: Record<string, string> = { '9xai': '#e5484d', z28: '#9b4dff', altibbi: '#2b6bff', iiab: '#3d8ad6', aau: '#c9a15b' };
/** Logos drawn in light line art (AAU's gold) read on a deep midnight planet, not the pale one. */
const DEEP = new Set(['aau']);
const latestDegree = degrees[0];
/*
 * In the galaxy journey a content stop is a few parts placed in space around the route
 * (journey.ts::placeParts): a card on the stop's side of the route and visuals on the other. A
 * part's data-at is "x,y,depth": x across in viewport widths, positive toward the stop's side, y
 * down in viewport heights, and extra depth in focal lengths. Cards default to "0.2,0,0".
 */
// The featured project, then the rest in pairs: on wide screens each pair is one stop of the journey
const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
const pairs = Array.from({ length: Math.ceil(rest.length / 2) }, (_, i) => rest.slice(i * 2, i * 2 + 2));
---

<Base
  lang={lang}
  title={title}
  description={t(person.description, lang)}
  canonical={pageUrl(lang)}
  alternates={{ en: pageUrl('en'), ar: pageUrl('ar') }}
  ogType="profile"
  jsonLd={profileGraph(lang, title)}
  journey
>
  <Header lang={lang} otherLangHref={ui[other].path} />

  <main id="main">
    <section id="hero" aria-labelledby="hero-name">
      <div class="container hero" data-stop="hero">
        <h1 class="hero-name" id="hero-name">{t(person.name, lang)}</h1>
        <p class="hero-role">{roleLine}</p>
        <p class="hero-lede">{t(person.intro, lang)}</p>
        <div class="hero-actions">
          <a class="btn" href={site.cv} download hreflang="en" type="application/pdf">
            <Icon name="download" />{s.downloadCv}
          </a>
          <a class="text-link" href={site.links.linkedin} rel="me noopener" target="_blank">
            <Icon name="linkedin" />{lang === 'en' ? 'LinkedIn' : 'لينكدإن'}
          </a>
          <a class="text-link" href={site.links.github} rel="me noopener" target="_blank">
            <Icon name="github" />{lang === 'en' ? 'GitHub' : 'غيت هب'}
          </a>
        </div>
        <ul class="stats">
          {
            highlights.map((h) => (
              <li>
                <strong>{t(h.value, lang)}</strong>
                <span>{t(h.label, lang)}</span>
              </li>
            ))
          }
        </ul>
        <p class="scroll-cue" id="scroll-cue" aria-hidden="true"><span>{s.scrollCue}</span></p>
      </div>
      <p class="sky-caption" id="sky-caption" hidden></p>
    </section>

    <section id="about" aria-labelledby="about-title">
      <div class="container">
        <h2 id="about-title" data-stop="title">{s.sections.about.title}</h2>
        <div class="two-col" data-stop="panel">
          <div class="about-text" data-part="card">
            {t(person.about, lang).map((p) => <p>{p}</p>)}
          </div>
          <dl class="facts">
            <div><dt>{s.facts.role}</dt><dd>{t(person.role, lang)}</dd></div>
            <div data-part="visual" data-at="-0.25,-0.25,0.22"><dt>{s.facts.basedIn}</dt><dd>{s.location}</dd></div>
            <div>
              <dt>{s.facts.current}</dt>
              <dd>
                <span class="fact-logos" aria-hidden="true"><Image src={current.logo} alt="" width={64} /></span>
                {t(current.title, lang)}, {s.since} {formatMonth(current.start, lang)}
              </dd>
            </div>
            <div>
              <dt>{s.facts.previously}</dt>
              <dd>
                <span class="fact-logos" aria-hidden="true">{previous.map((r) => <Image src={r.logo} alt="" width={64} />)}</span>
                {previous.map((r) => t(orgs[r.orgs[0]].name, lang)).join(comma)}
              </dd>
            </div>
            <div>
              <dt>{s.facts.education}</dt>
              <dd>
                <span class="fact-logos" aria-hidden="true"><Image src={latestDegree.logo} alt="" width={64} /></span>
                {t(latestDegree.degree, lang)}, {t(orgs[latestDegree.org].name, lang)} ({latestDegree.end ?? s.present})
              </dd>
            </div>
            <div data-part="visual" data-at="-0.17,-0.06,0.08"><dt>{s.facts.focus}</dt><dd>{t(person.knowsAbout, lang).join(comma)}</dd></div>
            <div data-part="visual" data-at="-0.29,0.13,0.3"><dt>{s.facts.languages}</dt><dd>{t(person.languages, lang)}</dd></div>
            <div data-part="visual" data-at="-0.19,0.27,0.18"><dt>{s.facts.openTo}</dt><dd>{t(person.openTo, lang)}</dd></div>
            <div><dt>{s.facts.contact}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="experience" aria-labelledby="experience-title">
      <div class="container">
        <h2 id="experience-title" data-stop="title">{s.sections.experience.title}</h2>
        <ol class="constellation">
          {
            experience.map((role) => (
              <li class="role" data-stop="panel">
                <div class="role-mark" data-part="visual" data-at="-0.27,-0.03,0.4">
                  {/* The bank's mark is a wide band inside a square image, so it gets more of the planet */}
                  <figure class:list={['moon', { wide: role.id === 'iiab' }]} style={`--brand:${BRAND[role.id]}`} aria-hidden="true">
                    <span class="planet"><Image src={role.logo} alt="" width={240} /></span>
                  </figure>
                  <time class="role-when" datetime={role.start}>
                    {formatPeriod(role.start, role.end, lang)}
                  </time>
                </div>
                <span class="role-star" aria-hidden="true" />
                <div class="role-body" data-part="card">
                  <h3>{t(role.title, lang)}</h3>
                  <p class="role-org">{orgNames(role.orgs)}</p>
                  {role.summary && <p class="role-summary">{t(role.summary, lang)}</p>}
                  {role.groups?.map((g) => (
                    <div class="role-group">
                      {g.title && <h4>{t(g.title, lang)}</h4>}
                      <ul class="bullets">
                        {t(g.bullets, lang).map((b, i) => <li class:list={{ extra: i >= SHOWN }}>{b}</li>)}
                      </ul>
                    </div>
                  ))}
                  {hidden(role) > 0 && (
                    <button class="more" type="button" aria-expanded="false" data-less={s.showFewer}>
                      {s.showAll}
                    </button>
                  )}
                  <ul class="tags">
                    {role.tags.map((x) => <li>{tag(x, lang)}</li>)}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="projects" aria-labelledby="projects-title">
      <div class="container">
        <h2 id="projects-title" data-stop="title">{s.sections.projects.title}</h2>
        <div class="projects">
          {
            [...featured.map((p) => [p]), ...pairs].map((group) => {
              const cards = group.map((p) => (
                <article
                  class:list={['project', { featured: p.featured }]}
                  id={`project-${p.id}`}
                  data-stop={p.featured ? 'panel' : undefined}
                  data-part={p.featured ? undefined : 'card'}
                  data-at={p.featured ? undefined : group.length === 1 ? '0.14,0,0' : group.indexOf(p) ? '0.21,0.08,0.25' : '-0.21,-0.07,0'}
                >
                  <div class="project-text" data-part={p.featured ? 'card' : undefined}>
                    <p class="project-context">{t(p.context, lang)}</p>
                    <h3>{t(p.name, lang)}</h3>
                    <p class="project-desc">{t(p.description, lang)}</p>
                    <ul class="tags">
                      {p.tech.map((x) => <li>{x}</li>)}
                    </ul>
                    <div class="project-links">
                      {p.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noopener">
                          <Icon name={l.kind === 'github' ? 'github' : l.kind === 'package' ? 'package' : 'external'} />
                          {t(l.label, lang)}
                        </a>
                      ))}
                    </div>
                  </div>
                  {p.featured && <div class="council-wrap" data-part="visual" data-at="-0.25,0,0.3"><Council lang={lang} /></div>}
                </article>
              ));
              return group[0].featured ? cards : (
                <div class:list={['project-pair', { single: group.length === 1 }]} data-stop="panel">{cards}</div>
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="education" aria-labelledby="education-title">
      <div class="container">
        <h2 id="education-title" data-stop="title">{s.sections.education.title}</h2>
        <ol class="degrees">
          {
            degrees.map((d) => (
              <li class="degree-stop" data-stop="panel">
                {/* Like a role: the university's planet and the years on one side, the degree on the other */}
                <div class="role-mark" data-part="visual" data-at="-0.27,-0.03,0.4">
                  <figure class:list={['moon', { deep: DEEP.has(d.org) }]} style={`--brand:${BRAND[d.org]}`} aria-hidden="true">
                    <span class="planet"><Image src={d.logo} alt="" width={240} /></span>
                  </figure>
                  <p class="role-when">{d.start} – {d.end ?? s.present}</p>
                </div>
                <article class="degree" data-part="card">
                  <h3>{t(d.degree, lang)}</h3>
                  <p class="role-org">{t(orgs[d.org].name, lang)}</p>
                  <p class="degree-badges">{d.badges.map((b) => t(b, lang)).join(comma)}</p>
                  <ul class="bullets">
                    {t(d.highlights, lang).map((b) => <li>{b}</li>)}
                  </ul>
                </article>
              </li>
            ))
          }
        </ol>
        <div class="certs-stop" data-stop="panel">
          <div class="certs-group" data-part="visual" data-at="0.12,0,0">
            <h3 class="certs-title">{s.sections.certifications}</h3>
            <ul class="certs">
              {
                certifications.map((c) => (
                  <li>
                    <div class="cert-head">
                      <h4>{t(c.name, lang)}</h4>
                      <time datetime={c.date}>{formatMonth(c.date, lang)}</time>
                    </div>
                    <p class="cert-org">{t(orgs[c.org].name, lang)}</p>
                    <p class="cert-note">{t(c.note, lang)}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="amman-now" aria-labelledby="contact-title">
      <div class="container contact">
        <h2 id="contact-title">{s.contact.title}</h2>
        <p>{lang === 'en' ? 'Open to ' : 'منفتح على '}{t(person.openTo, lang)}.</p>
        <div class="hero-actions">
          <a class="btn" href={`mailto:${site.email}`}>
            <Icon name="mail" />{s.contact.email}
          </a>
          <a class="text-link" href={site.links.linkedin} rel="me noopener" target="_blank">
            <Icon name="linkedin" />{s.contact.linkedin}
          </a>
          <a class="text-link" href={site.links.github} rel="me noopener" target="_blank">
            <Icon name="github" />{s.contact.github}
          </a>
        </div>
      </div>
      <Skyline />
    </section>
  </main>

  <Footer lang={lang} weather />
</Base>
