  const tiers = 24;
  const rx = (k: number) => 52 + k * 6;
  const ry = (k: number) => rx(k) * 0.24;
  const lift = 2.6;
  for (let k = tiers; k >= 1; k--) {
    const outer = arc(cx, cy - k * lift, rx(k), ry(k));
    const inner = arc(cx, cy - (k - 1) * lift, rx(k - 1), ry(k - 1)).reverse();
    const walkway = k === 9 || k === 17;
    poly(walkway ? '#a98f80' : k % 2 ? 'url(#amman-tread)' : 'url(#amman-riser)', [...outer, ...inner]);
  }
  poly('#e8d4b1', arc(cx, cy, rx(0), ry(0)));
  // Stairways climbing the seats, and the arched entrances through the top
  for (const a of [0.2, 0.35, 0.5, 0.65, 0.8]) {
