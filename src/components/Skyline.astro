};
const hex = (c: number[]) =>
  `${c.slice(0, 3).map((v) => v.toString(16).padStart(2, '0')).join('')}${c[3] < 1 ? Math.round(c[3] * 255).toString(16).padStart(2, '0') : ''}`;
const palette = [...colors.keys()].map(versions);
const firstLight = palette.map((c, i) => `--c${i}:#${hex(c.dawn)}`).join(';');
// The four versions for the script, in LOOKS order (astro.ts, shared with the script): eight hex
// digits (RGBA) per color, the looks separated by spaces. Plain hex, not JSON, whose quotes the
// attribute would escape
const rgba8 = (c: number[]) => `${hex(c.slice(0, 3).concat(1))}${Math.round(c[3] * 255).toString(16).padStart(2, '0')}`;
const looks = LOOKS.map((look) => palette.map((c) => rgba8(c[look])).join('')).join(' ');
---

<svg
  class="skyline"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  data-horizon={HORIZON_Y}
  data-looks={looks}
  style={firstLight}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient
      id="amman-sun"
      cx="0"
      cy={HORIZON_Y}
      r="560"
      gradientUnits="userSpaceOnUse"
      gradientTransform={`translate(0 ${HORIZON_Y}) scale(1 0.32) translate(0 ${-HORIZON_Y})`}
    >
      <stop offset="0" style={`stop-color:${D.sun[0]}`} stop-opacity="0.65"></stop>
      <stop offset="0.45" style={`stop-color:${D.sun[1]}`} stop-opacity="0.22"></stop>
      <stop offset="1" style={`stop-color:${D.sun[1]}`} stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="amman-far" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style={`stop-color:${D.far[0]}`}></stop>
      <stop offset="0.5" style={`stop-color:${D.far[1]}`}></stop>
    </linearGradient>
    <linearGradient id="amman-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style={`stop-color:${D.mist}`} stop-opacity="0"></stop>
      <stop offset="0.5" style={`stop-color:${D.mist}`} stop-opacity="0.3"></stop>
      <stop offset="1" style={`stop-color:${D.mist}`} stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="amman-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" style={`stop-color:${D.glass[0]}`}></stop>
      <stop offset="0.35" style={`stop-color:${D.glass[1]}`}></stop>
      <stop offset="1" style={`stop-color:${D.glass[2]}`}></stop>
    </linearGradient>
    <linearGradient id="amman-cylinder-cap" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" style={`stop-color:${D.cap[0]}`}></stop>
      <stop offset="1" style={`stop-color:${D.cap[1]}`}></stop>
    </linearGradient>
    <radialGradient id="amman-dome" cx="0.32" cy="0.25" r="0.85">
      <stop offset="0" style={`stop-color:${D.dome[0]}`}></stop>
      <stop offset="0.5" style={`stop-color:${D.dome[1]}`}></stop>
      <stop offset="1" style={`stop-color:${D.dome[2]}`}></stop>
    </radialGradient>
    <linearGradient id="amman-earth" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" style={`stop-color:${D.earth[0]}`}></stop>
      <stop offset="1" style={`stop-color:${D.earth[1]}`}></stop>
    </linearGradient>
    <linearGradient id="amman-tread" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" style={`stop-color:${D.tread[0]}`}></stop>
      <stop offset="1" style={`stop-color:${D.tread[1]}`}></stop>
    </linearGradient>
    <linearGradient id="amman-riser" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" style={`stop-color:${D.riser[0]}`}></stop>
      <stop offset="1" style={`stop-color:${D.riser[1]}`}></stop>
    </linearGradient>
    <!-- Repeating details on the towers: glass floor lines, window grids, stone floor lines -->
    <pattern id="amman-floors" width="10" height="5.5" patternUnits="userSpaceOnUse">
      <rect y="4.9" width="10" height="0.6" fill="rgba(14, 30, 46, 0.32)"></rect>
    </pattern>
    <pattern id="amman-flats" x="862" y="158" width="7" height="6.5" patternUnits="userSpaceOnUse">
      <rect width="3.6" height="3.4" style={`fill:${D.flats}`}></rect>
    </pattern>
    <pattern id="amman-offices" x="1296" y="202" width="6.5" height="7" patternUnits="userSpaceOnUse">
      <rect width="3" height="3.6" style={`fill:${D.offices}`}></rect>
    </pattern>
    <pattern id="amman-stone-floors" x="1014" y="104" width="10" height="7" patternUnits="userSpaceOnUse">
      <rect y="4" width="10" height="0.8" fill="rgba(110, 85, 70, 0.3)"></rect>
    </pattern>
    <pattern id="amman-podium" x="1150" y="240" width="10" height="7" patternUnits="userSpaceOnUse">
      <rect y="2" width="10" height="1.2" fill="rgba(200, 225, 235, 0.14)"></rect>
    </pattern>
    {
      windowStyles.map((s) => {
        const { stepX, stepY, ww, wh } = windowGrid(s);
        const frame = r1(0.6 * s.scale);
        return (
          <Fragment>
            <pattern id={`amman-win-${s.name}`} width={stepX} height={stepY} patternUnits="userSpaceOnUse">
              <rect width={ww} height={wh} style={`fill:${D.windows[s.name].pane}`}></rect>
            </pattern>
            <pattern id={`amman-win-${s.name}-framed`} width={stepX} height={stepY} patternUnits="userSpaceOnUse">
              <rect width={ww} height={wh} style={`fill:${D.windows[s.name].frame}`}></rect>
              <rect x={frame} y={frame} width={r1(ww - 2 * frame)} height={r1(wh - 2 * frame)} style={`fill:${D.windows[s.name].pane}`}></rect>
            </pattern>
            <pattern id={`amman-win-${s.name}-arched`} width={stepX} height={stepY} patternUnits="userSpaceOnUse">
              <path
                d={`M0 ${wh}V${r1(ww / 2)}A${r1(ww / 2)} ${r1(ww / 2)} 0 0 1 ${ww} ${r1(ww / 2)}V${wh}Z`}
                style={`fill:${D.windows[s.name].pane}`}
              ></path>
              <rect x={r1(-0.3 * s.scale)} y={wh} width={r1(ww + 0.6 * s.scale)} height={r1(0.6 * s.scale)} style={`fill:${D.windows[s.name].sill}`}></rect>
            </pattern>
          </Fragment>
        );
      })
    }
    <!-- Faint courses of stone on the nearest walls -->
    <pattern id="amman-courses" width="12" height="2.8" patternUnits="userSpaceOnUse">
      <rect y="2.3" width="12" height="0.35" fill="rgba(120, 90, 70, 0.14)"></rect>
      <rect x="6" y="0.9" width="0.35" height="1.4" fill="rgba(120, 90, 70, 0.1)"></rect>
    </pattern>
    <linearGradient id="amman-low" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3c2c48" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#3c2c48" stop-opacity="0.38"></stop>
    </linearGradient>
    <linearGradient id="amman-street" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#070a14" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#070a14" stop-opacity="0.92"></stop>
    </linearGradient>
  </defs>

  <rect width={W} height={HORIZON_Y + 40} fill="url(#amman-sun)" style="opacity:var(--sun, 1)"></rect>
  {
    drawn.map((l) => (
      <Fragment>
        {l.fills.map((p) => <path class:list={{ grove: l.grove }} fill={p.fill} style={p.style} d={p.d} />)}
        {l.caps && <path class="snowcap" d={l.caps} />}
        {l.strokes.map((st) => <path d={st.d} fill="none" style={st.style} stroke-width={st.width} stroke-linecap="round" />)}
        {l.lamps.map((g) => <path class:list={['lamp', { cool: g.cool }]} style={`--t:${g.tier}`} d={g.d} />)}
        {l.lights.map((w) => (
          <rect class:list={['lit', { fades: w.out < 70 }]} x={w.x} y={w.y} width={w.w} height={w.h} style={`--out:${w.out}%`} />
        ))}
        {l.greens.map((g) => <circle class="green" cx={g.x} cy={g.y} r={g.r} />)}
        {l.beacons.map((b, i) => <circle class="beacon" cx={b.x} cy={b.y} r="1.8" style={`animation-delay:${-i * 0.8}s`} />)}
      </Fragment>
    ))
  }
  {/* Rooftop pigeons, circling over the city */}
  <g class="pigeons" transform="translate(700 150)">
    <g class="flock">
      {
        pigeons.map(([x, y], i) => (
          <path
            class="pigeon"
            d={`M${x * 1.4 - 4.6} ${y * 1.4}Q${x * 1.4 - 2.3} ${y * 1.4 - 3.4} ${x * 1.4} ${y * 1.4}Q${x * 1.4 + 2.3} ${y * 1.4 - 3.4} ${x * 1.4 + 4.6} ${y * 1.4}`}
            style={`animation-delay:${(-i * 0.13).toFixed(2)}s`}
          />
        ))
      }
    </g>
  </g>
</svg>
{/* Weather in front of the city: haze and mist near the far hills, rain or snow falling, fading out
    above the skyline so the contact text stays clear. Hidden until the weather says otherwise */}
<div class="weather-front" aria-hidden="true" style={`--rain-tile:${rainTile};--snow-tile:${snowTile}`}>
  <div class="wf-haze"></div>
  <div class="wf-mist"></div>
  <div class="wf-fall wf-rain"><i></i><i></i></div>
  <div class="wf-fall wf-snow"><i></i><i></i></div>
</div>

<script>
  // Amman at its real time of day: each color's four versions (data-looks) blended by how much of
  // night, dawn, day and dusk it is in Amman now (astro.ts::daylight), with the windows, the
  // lanterns, the birds and the sky's glow to match. Refreshed each minute, so a long visit sees
  // the light change.
  import { daylight, LOOKS, mainLook, now, type Daylight, type Look } from '../scripts/sky/astro';
  import { onWeather, type Weather } from '../scripts/weather';

  // Amman's weather for this half of the day (scripts/weather.ts), once it arrives
  let weather: Weather | null = null;
  // What the weather does to the city, by look: the air dust and fog mix in, and snow's color
  const DUST_AIR: Record<Look, number[]> = { night: [74, 58, 44], dawn: [196, 148, 104], day: [204, 168, 120], dusk: [190, 130, 90] };
  const FOG_AIR: Record<Look, number[]> = { night: [66, 72, 92], dawn: [206, 198, 204], day: [216, 220, 226], dusk: [196, 182, 190] };
  // Snow at night still catches the city's light: bright against the dark houses
  const SNOW: Record<Look, number[]> = { night: [186, 190, 214], dawn: [240, 230, 238], day: [246, 248, 252], dusk: [236, 218, 228] };

  // The scene's wash over the sky, [middle, low, bottom] as [r, g, b, alpha], by look
  const WASH: Record<Look, number[][]> = {
    night: [[8, 12, 34, 0.5], [60, 46, 96, 0.3], [80, 60, 110, 0.4]],
    dawn: [[26, 34, 80, 0.55], [240, 163, 94, 0.32], [240, 163, 94, 0.5]],
    day: [[30, 70, 140, 0.22], [230, 240, 250, 0.16], [240, 246, 252, 0.28]],
    dusk: [[30, 30, 80, 0.5], [220, 130, 140, 0.3], [230, 140, 150, 0.45]],
  };

  const svg = document.querySelector<SVGSVGElement>('.skyline');
  const scene = svg?.closest<HTMLElement>('section');
  if (svg?.dataset.looks) {
    // Eight hex digits (RGBA) per color, the looks in LOOKS order, separated by spaces
    const palettes = svg.dataset.looks.split(' ').map((run) =>
      Array.from({ length: run.length / 8 }, (_, i) => [0, 2, 4, 6].map((j) => parseInt(run.slice(i * 8 + j, i * 8 + j + 2), 16))),
    );
    const css = (c: number[], alpha = c[3] / 255) =>
      `rgb(${Math.round(c[0])} ${Math.round(c[1])} ${Math.round(c[2])} / ${alpha.toFixed(3)})`;
    const front = scene?.querySelector<HTMLElement>('.weather-front');
    const byLight = (table: Record<Look, number[]>, light: Daylight) =>
      [0, 1, 2].map((j) => LOOKS.reduce((sum, k) => sum + table[k][j] * light[k], 0));
    /**
     * A color under the weather: overcast light is flatter and dimmer; rain darkens and deepens
     * the stone, as wet; dust and fog mix in their air.
     */
    const weathered = (c: number[], light: Daylight) => {
      const wx = weather;
      if (!wx) return c;
      const grey = Math.min(1, Math.max((wx.cloud - 0.35) / 0.6, wx.rain * 1.3, wx.snow * 1.2, wx.storm ? 1 : 0));
      const dim = 1 - 0.1 * grey - 0.1 * wx.rain;
      let rgb = c.slice(0, 3).map((v) => v * dim);
      const avg = (rgb[0] + rgb[1] + rgb[2]) / 3;
      const sat = wx.rain > 0 ? 0.14 : -0.15 * grey;
      rgb = rgb.map((v) => Math.max(0, Math.min(255, v + (v - avg) * sat)));
      const into = (target: number[], k: number) => (rgb = rgb.map((v, i) => v + (target[i] - v) * k));
      if (wx.dust > 0) into(byLight(DUST_AIR, light), 0.24 * wx.dust);
      if (wx.fog > 0) into(byLight(FOG_AIR, light), 0.16 * wx.fog);
      return [...rgb, c[3]];
    };
    // The front layer starts just under the contact text, wherever the layout puts it
    const words = scene?.querySelector<HTMLElement>('.contact');
    const placeFront = () => {
      if (front && words) front.style.top = `${words.offsetTop + words.offsetHeight + 8}px`;
    };
    addEventListener('resize', placeFront);
    /** Rain, snow, haze, mist and wind in front of the city, for the weather and the hour. */
    const showWeather = (light: Daylight) => {
      placeFront();
      const wx = weather;
      const dark = light.night + 0.5 * (light.dawn + light.dusk);
      svg.toggleAttribute('data-windy', !!wx && wx.wind >= 0.5);
      svg.style.setProperty('--wind', (wx?.wind ?? 0).toFixed(2));
      svg.style.setProperty('--snow', wx && wx.snow > 0 ? '1' : '0');
      svg.style.setProperty('--snowcap', `rgb(${byLight(SNOW, light).map(Math.round).join(' ')})`);
      if (!front) return;
      front.toggleAttribute('data-rain', !!wx && wx.rain > 0);
      front.toggleAttribute('data-snow', !!wx && wx.snow > 0);
      if (!wx) return;
      front.style.setProperty('--rain', (wx.rain * (0.8 - 0.3 * dark)).toFixed(3));
      front.style.setProperty('--snow', (0.45 + 0.55 * wx.snow).toFixed(3));
      const dusty = wx.dust >= wx.fog;
      front.style.setProperty('--haze', Math.max(wx.dust, wx.fog).toFixed(3));
      front.style.setProperty('--haze-rgb', byLight(dusty ? DUST_AIR : FOG_AIR, light).map(Math.round).join(' '));
      // Rain and snow lean with the wind: from the east one way, from the west the other
      const side = Math.sin((wx.windFrom * Math.PI) / 180) >= 0 ? 1 : -1;
      front.style.setProperty('--slant', `${(side * (3 + 20 * wx.wind)).toFixed(1)}deg`);
    };
    const paint = () => {
      const light = daylight(now());
      const w = LOOKS.map((look) => light[look]);
      const blend = (colors: number[][]) => [0, 1, 2, 3].map((j) => colors.reduce((sum, c, k) => sum + c[j] * w[k], 0));
      palettes[0].forEach((_, i) => svg.style.setProperty(`--c${i}`, css(weathered(blend(palettes.map((p) => p[i])), light))));
      showWeather(light);
      // Windows light up as it gets dark; people are home at dusk, and a few are still up at dawn
      svg.style.setProperty('--lamps', Math.max(light.night, 0.8 * light.dusk, 0.3 * light.dawn).toFixed(3));
      svg.style.setProperty('--lights', (1 - light.day).toFixed(3));
      svg.style.setProperty('--sun', (light.dawn + 0.5 * light.day + 0.45 * light.dusk).toFixed(3));
      // The pigeons stay in at night, and out of rain, snow, dust or a gale
      const grounded = !!weather && (weather.rain > 0 || weather.snow > 0 || weather.dust > 0.4 || weather.wind > 0.8);
      svg.style.setProperty('--birds', grounded ? '0' : (1 - light.night).toFixed(3));
      // At dawn the last lights go out as the city comes into view (global.css, lights-out)
      svg.classList.toggle('at-dawn', mainLook(light) === 'dawn');
      if (!scene) return;
      scene.dataset.look = mainLook(light);
      // The wash takes the weather too, and fades under a grey sky, where it would only tint it
      const grey = weather ? Math.min(1, Math.max((weather.cloud - 0.35) / 0.6, weather.rain * 1.3, weather.snow * 1.2, weather.dust)) : 0;
      ['mid', 'low', 'floor'].forEach((name, i) => {
        const c = weathered(blend(LOOKS.map((look) => WASH[look][i])), light);
        scene.style.setProperty(`--wash-${name}`, css(c, c[3] * (1 - 0.6 * grey)));
      });
    };
    paint();
    setInterval(paint, 60_000);
    onWeather((w) => {
      weather = w;
      paint();
    });
  }
</script>
