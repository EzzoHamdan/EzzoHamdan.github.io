---
import { LOOKS, type Look } from '../scripts/sky/astro';

// Amman at first light, the last scene of the page: the low sun from the east (the left) lights
// the limestone city warm and gold while the sky above still holds the night. Back to front:
// hazy far hills blanketed in small houses, with a rim of light on their crest; the Abdali towers
// in glass and stone, among them the round-topped cylinder; King Abdullah I Mosque with its
// turquoise dome and two balconied minarets, a church bell tower beside it; Citadel hill with
// the Temple of Hercules (two columns still carrying their beam, a third alone, a broken stump);
// the middle hills stacked with stone houses; the Roman Theatre's tiers carved into the hill in
// the foreground; the nearest houses, the more detailed the nearer (parapets, water tanks, solar
// heaters and dishes on the roofs; arched, plain or blue-framed windows, balconies, floor
// lines, air conditioners and stone courses on the walls); trees rising from behind the houses
// (cypresses, Aleppo pines, olives, date palms); minarets lit green; red beacons on the tallest
// towers; rooftop pigeons.
//
// Generated deterministically at build time. Shapes are merged by color into one path each, layer
// by layer, so the whole city is a few dozen elements however many houses it has. The sky's
// horizon sits at HORIZON_Y in this viewBox, at the far hills' lowest crest, so the canvas ground
// is always tucked behind them; Sky.astro and journey.ts read it from data-horizon.
const W = 1440;
const H = 420;

let seed = 23;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const between = (a: number, b: number) => a + rand() * (b - a);
const pick = <T,>(xs: T[]) => xs[Math.floor(rand() * xs.length)];
const r1 = (n: number) => Math.round(n * 10) / 10;
// Coordinates are written with one decimal near the viewer and whole numbers in the distance,
// where half a unit is invisible; it keeps the markup small
let decimals = 10;
const f = (n: number) => Math.round(n * decimals) / decimals;
const bump = (x: number, center: number, flat: number, fall: number) => {
  const t = Math.min(1, Math.max(0, (Math.abs(x - center) - flat) / fall));
  return 1 - t * t * (3 - 2 * t);
};

// Colors: sunlit limestone in a few tones, lavender shadow, and the pink-lavender dawn air that
// distance mixes into everything
const STONES = ['#e6c99f', '#dcbd92', '#ecd5b2', '#e0c0a4', '#d4b48a'];
const SIDE = '#a99195';
const ROOF = '#f8ead0';
const WINDOW = '#5b566d';
const FRAME = '#5f86ad';
const SHADE = '#bc9f86';
const RAIL = '#5f5a6c';
const PANEL = '#2f4560';
const WHITE = '#eeedf0';
const DARK = '#2c2b34';
const HAZE = [190, 160, 178];
// A color seen through `haze` of the air, kept as a key (color~haze) and turned into one color
// per time of day at the end (see "Time of day" below)
const tone = (hex: string, haze: number) => (haze ? `${hex}~${haze}` : hex);

// Terrain, in viewBox units (y grows downward)
const far = (x: number) => 214 - 13 * Math.sin(x / 250 + 0.5) - 6 * Math.sin(x / 88 + 2) - 3 * Math.sin(x / 33);
const citadel = (x: number) => 302 - 66 * bump(x, 210, 112, 66) - 1.5 * Math.sin(x / 17);
const middle = (x: number) => 292 - 8 * Math.sin(x / 160 + 1.2) - 4 * Math.sin(x / 47);
const jofeh = (x: number) => 306 - 32 * bump(x, 300, 120, 170) - 2 * Math.sin(x / 29);
const near = (x: number) => 352 - 6 * Math.sin(x / 120 + 0.4) - 3 * Math.sin(x / 37);
const HORIZON_Y = Math.ceil(Math.max(...Array.from({ length: W + 1 }, (_, x) => far(x)))) + 1;

// Layers, painted in order. Within a layer, shapes of one fill share a path
interface Light { x: number; y: number; w: number; h: number; out: number }
/** A window lit at night: tier 0..3 is how dark it must be for it to come on; some are cool LEDs. */
interface Lamp { x: number; y: number; w: number; h: number; tier: number; cool: boolean }
interface Layer {
  /** Walls, painted before everything else in the layer, so no wall ever covers a window. */
  walls: Map<string, string[]>;
  paths: Map<string, string[]>;
  /** Where each fill's path pen is, so the next shape can move to it relatively. */
  pens: Map<string, [number, number]>;
  strokes: { d: string; stroke: string; width: number }[];
  lights: Light[];
  lamps: Lamp[];
  /** Snow on the roofs, shown only when it snows (`.snowcap`, the weather script). */
  caps: number[][];
  /** A grove's trees, which sway in the wind. */
  grove?: boolean;
  greens: { x: number; y: number; r: number }[];
  beacons: { x: number; y: number }[];
}
const layers: Layer[] = [];
let L!: Layer;
const layer = () => {
  L = { walls: new Map(), paths: new Map(), pens: new Map(), strokes: [], lights: [], lamps: [], caps: [], greens: [], beacons: [] };
  layers.push(L);
};
// What lights a shape at night: nothing for the city, which goes dark; 'flood' for the landmarks
// Amman floodlights (the Citadel, the theatre, the mosque, the church); 'dome' for the mosque's
// turquoise, which stays turquoise under its lights; 'glow' for the towers' windows. Set around a
// landmark's drawing; it becomes part of the fill's key, so lit and unlit shapes never share a path
type Kind = '' | 'flood' | 'dome' | 'glow';
let kind: Kind = '';
const paint = (fill: string) => (kind && !fill.startsWith('url') ? `${fill}|${kind}` : fill);
// Within a layer, shapes of one fill share a path, and paths paint in the order their fill was
// first used. Walls go in a pass of their own first: a wall tone first used after some windows
// were drawn would otherwise paint over them.
const add = (fill: string, d: string, wall = false) => {
  const map = wall ? L.walls : L.paths;
  const list = map.get(fill) ?? [];
  list.push(d);
  map.set(fill, list);
};
/** A path written by hand, in absolute coordinates: the fill's next shape starts afresh. */
const addRaw = (raw: string, d: string) => {
  const fill = paint(raw);
  add(fill, d);
  L.pens.delete(`false|${fill}`);
};
// Numbers as short as SVG allows: ".5" for 0.5, "-.5" for -0.5
const n = (v: number) => String(f(v)).replace(/^(-?)0\./, '$1.');
// Subpaths are left open (a fill closes each one by itself) and start with a move relative to
// where the fill's previous shape ended, which keeps most numbers to one or two digits
const moveTo = (pen: [number, number] | undefined, x: number, y: number) =>
  pen ? `m${n(f(x) - pen[0])} ${n(f(y) - pen[1])}` : `M${n(x)} ${n(y)}`;
const rect = (raw: string, x: number, y: number, w: number, h: number, wall = false) => {
  const fill = paint(raw);
  const key = `${wall}|${fill}`;
  add(fill, `${moveTo(L.pens.get(key), x, y)}h${n(w)}v${n(h)}h${n(-w)}`, wall);
  L.pens.set(key, [f(x), f(f(y) + f(h))]);
};
const poly = (raw: string, pts: number[][], wall = false) => {
  const fill = paint(raw);
  const key = `${wall}|${fill}`;
  let d = moveTo(L.pens.get(key), pts[0][0], pts[0][1]);
  for (let i = 1; i < pts.length; i++) d += `l${n(f(pts[i][0]) - f(pts[i - 1][0]))} ${n(f(pts[i][1]) - f(pts[i - 1][1]))}`;
  add(fill, d, wall);
  const last = pts[pts.length - 1];
  L.pens.set(key, [f(last[0]), f(last[1])]);
};
const line = (stroke: string, width: number, pts: number[][]) =>
  L.strokes.push({ d: `M${pts.map(([x, y]) => `${f(x)} ${f(y)}`).join('L')}`, stroke: paint(stroke), width });
const sample = (fn: (x: number) => number, x0: number, x1: number, step = 8) => {
  const pts: number[][] = [];
  for (let x = x0; x < x1; x += step) pts.push([x, fn(x)]);
  pts.push([x1, fn(x1)]);
  return pts;
};
// Hills are in the wall pass too, under the houses that stand on them
const hill = (fill: string, fn: (x: number) => number, x0 = 0, x1 = W) => poly(fill, [[x0, H], ...sample(fn, x0, x1), [x1, H]], true);
/** The upper half of an ellipse, left to right. */
const arc = (cx: number, cy: number, rx: number, ry: number, n = 22) =>
  Array.from({ length: n + 1 }, (_, i) => {
    const a = Math.PI - (i / n) * Math.PI;
    return [cx + rx * Math.cos(a), cy - ry * Math.sin(a)];
  });
const dome = (fill: string, cx: number, cy: number, rx: number, ry: number) => poly(fill, arc(cx, cy, rx, ry));

// Night lights draw from their own sequence too, so lighting windows never reshuffles the houses
let lampSeed = 41;
const P = () => (lampSeed = (lampSeed * 16807) % 2147483647) / 2147483647;
/** Share of windows lit at night, when it is fully dark. */
const LAMPS = 0.4;
const lamp = (x: number, y: number, w: number, h: number) =>
  L.lamps.push({ x: r1(x), y: r1(y), w: r1(w), h: r1(h), tier: Math.floor(P() * 4), cool: P() < 0.25 });

interface HouseStyle {
  /** For the window pattern's id. */
  name: string;
  /** Size of details (windows, tanks) relative to the nearest houses. */
  scale: number;
  /** How much dawn air lies between the house and the viewer, 0..1. */
  haze: number;
  windows: boolean;
  lit: number;
  maxCols: number;
  maxRows: number;
}
/**
 * A stone house: sunlit front, shadowed east side, a bright roof edge with the shadow of its eave,
 * and, the nearer it is, more of what Amman's houses carry: parapets, water tanks, solar water
 * heaters, satellite dishes and antennas on the roof; arched, plain or blue-framed windows,
 * balconies, floor lines, air conditioners and stone courses on the walls.
 */
function house(x: number, base: number, w: number, h: number, s: HouseStyle) {
  const k = s.scale;
  const front = tone(pick(STONES), s.haze);
  const sideW = Math.max(1.2, w * 0.15);
  const face = w - sideW;
  const top = base - h;
  // Walls run on down the slope behind the next row, so no gaps show between rows; far away a
  // short run is enough (a long one reads as stripes)
  const run = h + 34 * k ** 2;
  rect(front, x, top, face, run, true);
  rect(tone(SIDE, s.haze), x + face, top + 0.8 * k, sideW, run, true);
  if (k < 0.4) {
    L.caps.push([x, top - 0.6, face, 1.3]);
    // Too far for windows: at night a light or two per house, so the far hills glitter
    for (let i = 0; i < 2; i++) if (P() < 0.45) lamp(x + P() * Math.max(0, face - 1.2), top + 0.8 + P() * Math.max(0, h - 2), 1.2, 1);
    return;
  }
  const near = k >= 0.9;
  if (near) rect('url(#amman-courses)', x, top, face, h);

  // The roof: a parapet on some, the lit edge, the eave's shadow below it
  const roof = rand() < 0.45 ? top - 1.7 * k : top;
  if (roof < top) rect(front, x, roof, face, top - roof, true);
  rect(tone(ROOF, s.haze), x, roof, face, 1.2 * k);
  rect(tone(SHADE, s.haze), x, top + 1.3 * k, face, 0.9 * k);
  // Snow lies along the roof's edge, a little over it (shown only when it snows)
  L.caps.push([x - 0.4 * k, roof - 1.6 * k, face + 0.8 * k, 2.6 * k]);

  // What stands on the roof, left to right, each in its own spot
  let at = x + between(1, 4) * k;
  const end = x + face - 2 * k;
  const place = (width: number) => {
    if (at + width > end) return NaN;
    const px = at;
    at += width + between(1.5, 5) * k;
    return px;
  };
  if (rand() < 0.3 && face > 12 * k) {
    const rw = face * between(0.2, 0.34);
    const rh = between(4, 7) * k;
    const rx = place(rw);
    if (!Number.isNaN(rx)) {
      rect(front, rx, roof - rh, rw, rh, true);
      rect(tone(SIDE, s.haze), rx + rw - 1.2 * k, roof - rh + 1.1 * k, 1.2 * k, rh - 1.1 * k, true);
      rect(tone(ROOF, s.haze), rx, roof - rh, rw, 1.1 * k);
    }
  }
  const items = Math.floor(between(0, near ? 4 : 3));
  for (let i = 0; i < items; i++) {
    const kind = pick(['tank', 'tank', 'solar', 'dish']);
    if (kind === 'tank') {
      const tx = place(4.5 * k);
      if (Number.isNaN(tx)) break;
      const tank = rand() < 0.5 ? DARK : WHITE;
      rect(tone(tank, s.haze), tx, roof - 3.2 * k, 4.5 * k, 3.2 * k);
      rect(tone(tank === DARK ? '#55535f' : '#ffffff', s.haze), tx, roof - 3.2 * k, 4.5 * k, 0.7 * k);
    } else if (kind === 'solar') {
      // A tilted collector with its white tank along the top
      const sx = place(7 * k);
      if (Number.isNaN(sx)) break;
      poly(tone(PANEL, s.haze), [[sx, roof], [sx + 1.4 * k, roof], [sx + 6.4 * k, roof - 3.4 * k], [sx + 5 * k, roof - 3.4 * k]]);
      rect(tone(WHITE, s.haze), sx + 3.6 * k, roof - 5.2 * k, 3.6 * k, 1.8 * k);
    } else {
      const dx = place(4 * k);
      if (Number.isNaN(dx)) break;
      const cx = dx + 2 * k;
      const cy = roof - 2.6 * k;
      poly(tone('#e4e3e8', s.haze), Array.from({ length: 9 }, (_, j) => {
        const a = (j / 8) * Math.PI * 2;
        const ex = 2 * k * Math.cos(a);
        const ey = 0.8 * k * Math.sin(a);
        return [cx + ex * 0.77 + ey * 0.64, cy - ex * 0.64 + ey * 0.77];
      }));
      rect(tone(RAIL, s.haze), cx - 0.25 * k, cy, 0.5 * k, roof - cy);
    }
  }

  if (!s.windows) return;
  // The windows are one rectangle filled with the style's window pattern, its grid snapped to the
  // pattern's, so a house of twenty windows is still one shape
  const { stepX, stepY, ww, wh } = windowGrid(s);
  const inner = face - 4 * k;
  const cols = Math.min(s.maxCols, Math.floor((inner - ww) / stepX) + 1);
  const rows = Math.min(s.maxRows, Math.floor((h + 18 * k - wh) / stepY) + 1);
  if (cols < 1 || rows < 1) return;
  // Centered on the face, as near as the shared grid allows
  const x0 = Math.round((x + 2 * k + (inner - (cols - 1) * stepX - ww) / 2) / stepX) * stepX;
  const y0 = Math.ceil((top + 4.5 * k) / stepY) * stepY;
  const gridW = (cols - 1) * stepX + ww;
  rect(`url(#amman-win-${s.name}${pick(['', '', '-framed', '-arched'])})`, x0, y0, gridW, (rows - 1) * stepY + wh);

  if (near) {
    // Balconies with railings on some houses, a line at each floor on the rest
    const balconies = rand() < 0.4;
    const rail = tone(rand() < 0.5 ? FRAME : RAIL, s.haze);
    for (let r = 0; r < rows; r++) {
      const below = y0 + r * stepY + wh;
      if (balconies && r > 0) {
        rect(tone(ROOF, s.haze), x0 - 1.4 * k, below + 0.3 * k, gridW + 2.8 * k, 1 * k);
        rect(tone(SHADE, s.haze), x0 - 1.4 * k, below + 1.3 * k, gridW + 2.8 * k, 0.8 * k);
        rect(rail, x0 - 1.4 * k, below - 2.2 * k, gridW + 2.8 * k, 0.55 * k);
      } else if (r < rows - 1) {
        rect(tone(SHADE, s.haze), x, below + (stepY - wh) * 0.5, face, 0.45 * k);
      }
    }
    // An air conditioner or two beside the windows
    for (let i = rand() < 0.5 ? 1 : 2; i > 0; i--) {
      const c = Math.floor(rand() * cols);
      const r = Math.floor(rand() * rows);
      const ax = x0 + c * stepX + ww + 0.5 * k;
      if (ax + 2.4 * k < x + face) rect(tone('#d8d8de', s.haze), ax, y0 + r * stepY + wh * 0.45, 2.4 * k, 1.7 * k);
    }
  }

  // A few windows are still lit from the night, over their dark pane
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (rand() < s.lit) {
        L.lights.push({ x: r1(x0 + c * stepX + ww * 0.2), y: r1(y0 + r * stepY + wh * 0.35), w: r1(ww * 0.6), h: r1(wh * 0.5), out: Math.round(rand() * 100) });
      }
    }
  }
  // At night, many more: whole panes, from the lamps' own sequence
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (P() < LAMPS) lamp(x0 + c * stepX + 0.2 * k, y0 + r * stepY + 0.2 * k, ww - 0.4 * k, wh - 0.4 * k);
    }
  }
}
/** A window style's grid: one window per stepX by stepY cell, ww by wh, in the cell's corner. */
function windowGrid(s: HouseStyle) {
  return { stepX: r1(7 * s.scale), stepY: r1(8 * s.scale), ww: r1(3.2 * s.scale), wh: r1(3.8 * s.scale) };
}
/** A row of houses along a hill's crest, `sink` below it, skipping where landmarks stand. */
function row(f: (x: number) => number, x0: number, x1: number, size: [number, number, number, number], sink: number, s: HouseStyle, skip?: (x: number) => boolean) {
  const [minW, maxW, minH, maxH] = size;
  for (let x = x0; x < x1; ) {
    const w = between(minW, maxW);
    if (skip?.(x + w / 2)) {
      x += w;
      continue;
    }
    house(x, f(x + w / 2) + sink + between(0, 3) * s.scale, w, between(minH, maxH), s);
    x += w + between(0, 3) * s.scale;
  }
}
/** A cypress: a dark flame, lit on its sunward side. */
function cypress(x: number, base: number, h: number, haze = 0) {
  const w = h * 0.16;
  const pts = [[x, base - h], [x + w * 0.42, base - h * 0.62], [x + w * 0.5, base - h * 0.25], [x + w * 0.3, base], [x - w * 0.3, base], [x - w * 0.5, base - h * 0.25], [x - w * 0.42, base - h * 0.62]];
  poly(tone('#2f4637', haze), pts);
  poly(tone('#4d6a52', haze), [[x, base - h], [x - w * 0.42, base - h * 0.62], [x - w * 0.5, base - h * 0.25], [x - w * 0.3, base], [x - w * 0.05, base]]);
}
// Trees draw from their own sequence, so adding or moving them never reshuffles the houses
let treeSeed = 97;
const R = () => (treeSeed = (treeSeed * 16807) % 2147483647) / 2147483647;
/** A leafy blob: an ellipse written as two arcs, a third of the markup of a polygon. */
const blob = (raw: string, cx: number, cy: number, rx: number, ry: number) => {
  const fill = paint(raw);
  const key = `false|${fill}`;
  add(fill, `${moveTo(L.pens.get(key), cx - rx, cy)}a${n(rx)} ${n(ry)} 0 1 0 ${n(2 * rx)} 0a${n(rx)} ${n(ry)} 0 1 0 ${n(-2 * rx)} 0`);
  L.pens.set(key, [f(cx - rx), f(cy)]);
};
/** An Aleppo pine: a slim trunk and a broad, flat, cloud-like crown. */
function pine(x: number, base: number, h: number, haze: number) {
  const top = base - h * 0.62;
  poly(tone('#5a4637', haze), [[x - h * 0.026, base], [x - h * 0.012, top], [x + h * 0.012, top], [x + h * 0.026, base]]);
  const cy = base - h * 0.8;
  const w = h * 0.38;
  for (let i = 0; i < 4; i++) {
    blob(tone('#34503f', haze), x + (R() - 0.5) * w * 1.3, cy + (R() - 0.5) * h * 0.14, w * (0.38 + 0.22 * R()), h * (0.09 + 0.05 * R()));
  }
  for (let i = 0; i < 2; i++) {
    blob(tone('#5a7a57', haze), x - w * (0.1 + 0.35 * R()), cy - h * (0.04 + 0.05 * R()), w * (0.18 + 0.12 * R()), h * 0.055);
  }
}
/** An olive: a short, forked trunk and a round, silvery crown. */
function olive(x: number, base: number, h: number, haze: number) {
  const fork = base - h * 0.42;
  poly(tone('#6b5a48', haze), [[x - h * 0.05, base], [x - h * 0.02, fork], [x - h * 0.12, fork - h * 0.12], [x + h * 0.1, fork - h * 0.14], [x + h * 0.03, fork], [x + h * 0.05, base]]);
  const cy = base - h * 0.66;
  for (let i = 0; i < 4; i++) {
    blob(tone('#647659', haze), x + (R() - 0.5) * h * 0.42, cy + (R() - 0.5) * h * 0.22, h * (0.2 + 0.08 * R()), h * (0.15 + 0.06 * R()));
  }
  for (let i = 0; i < 2; i++) {
    blob(tone('#9fae88', haze), x - h * (0.06 + 0.16 * R()), cy - h * (0.06 + 0.08 * R()), h * (0.09 + 0.05 * R()), h * 0.07);
  }
}
/** A date palm: a leaning, ringed trunk and drooping fronds. */
function palm(x: number, base: number, h: number, haze: number) {
  const lean = (R() - 0.5) * h * 0.2;
  const at = (t: number) => [x + lean * t * t, base - h * t];
  const [mx, my] = at(0.5);
  const [tx, ty] = at(1);
  poly(tone('#8b7660', haze), [[x - h * 0.026, base], [mx - h * 0.021, my], [tx - h * 0.016, ty], [tx + h * 0.016, ty], [mx + h * 0.021, my], [x + h * 0.026, base]]);
  for (let i = 0; i < 7; i++) {
    const a = Math.PI * (1.05 + (i / 6) * 0.9);
    const length = h * (0.34 + 0.08 * R());
    const tipX = tx + Math.cos(a) * length;
    const tipY = ty + Math.sin(a) * length * 0.55 + length * 0.42 * Math.abs(Math.cos(a));
    const midX = (tx + tipX) / 2;
    const midY = (ty + tipY) / 2 - length * 0.12;
    const wide = h * 0.03;
    poly(tone(i < 3 ? '#66854f' : '#3c5a3c', haze), [[tx, ty], [midX, midY - wide], [tipX, tipY], [midX, midY + wide]]);
  }
}
type Tree = 'cypress' | 'pine' | 'olive' | 'palm';
/**
 * A grove along a hill, drawn in its own layer just before the row of houses in front of it, so
 * the houses hide the trunks and the crowns rise over the roofs. `sink` puts the trees' feet below
 * the hill line; heights between hMin and hMax.
 */
function grove(fn: (x: number) => number, x0: number, x1: number, count: number, sink: number, hMin: number, hMax: number, haze: number, kinds: Tree[], skip?: (x: number) => boolean) {
  layer();
  L.grove = true;
  for (let i = 0; i < count; i++) {
    const x = x0 + ((i + 0.15 + R() * 0.7) * (x1 - x0)) / count;
    if (skip?.(x)) continue;
    const h = hMin + R() * (hMax - hMin);
    const base = fn(x) + sink;
    const kind = kinds[Math.floor(R() * kinds.length)];
    if (kind === 'cypress') cypress(x, base, h * 1.15, haze);
    else if (kind === 'pine') pine(x, base, h, haze);
