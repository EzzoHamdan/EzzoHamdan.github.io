const FIXED: Record<string, Partial<Record<Look, number[]>>> = {
  sun: { day: [255, 248, 232, 1], dusk: [255, 178, 166, 1], night: [0, 0, 0, 0] },
  mist: { day: [232, 238, 246, 1], dusk: [234, 172, 174, 1], night: [58, 60, 100, 1] },
  rim: { day: [255, 250, 240, 0.5], dusk: [255, 186, 170, 0.6], night: [0, 0, 0, 0] },
