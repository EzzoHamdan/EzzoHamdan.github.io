<svg class="skyline" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" data-horizon={HORIZON_Y} aria-hidden="true" focusable="false">
  <defs>
    <radialGradient
      id="amman-sun"
      cx="0"
      cy={HORIZON_Y}
      r="560"
      gradientUnits="userSpaceOnUse"
      gradientTransform={`translate(0 ${HORIZON_Y}) scale(1 0.32) translate(0 ${-HORIZON_Y})`}
    >
      <stop offset="0" stop-color="#ffd8a2" stop-opacity="0.65"></stop>
      <stop offset="0.45" stop-color="#ffb98a" stop-opacity="0.22"></stop>
      <stop offset="1" stop-color="#ffb98a" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="amman-far" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b597ae"></stop>
      <stop offset="0.5" stop-color="#9e839f"></stop>
    </linearGradient>
    <linearGradient id="amman-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3cbbd" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#f3cbbd" stop-opacity="0.3"></stop>
      <stop offset="1" stop-color="#f3cbbd" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="amman-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7aa9bb"></stop>
      <stop offset="0.35" stop-color="#3f6a80"></stop>
      <stop offset="1" stop-color="#22394d"></stop>
    </linearGradient>
    <linearGradient id="amman-cylinder-cap" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#9cc6d4"></stop>
      <stop offset="1" stop-color="#2c4d62"></stop>
    </linearGradient>
    <radialGradient id="amman-dome" cx="0.32" cy="0.25" r="0.85">
      <stop offset="0" stop-color="#bff2f1"></stop>
      <stop offset="0.5" stop-color="#46b8c6"></stop>
      <stop offset="1" stop-color="#1b6f82"></stop>
    </radialGradient>
    <linearGradient id="amman-earth" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#cfa98a"></stop>
      <stop offset="1" stop-color="#9f8074"></stop>
    </linearGradient>
    <linearGradient id="amman-tread" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f2ddb7"></stop>
      <stop offset="1" stop-color="#d6ba96"></stop>
    </linearGradient>
    <linearGradient id="amman-riser" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#cdb092"></stop>
      <stop offset="1" stop-color="#a98e7f"></stop>
    </linearGradient>
    <!-- Repeating details on the towers: glass floor lines, window grids, stone floor lines -->
    <pattern id="amman-floors" width="10" height="5.5" patternUnits="userSpaceOnUse">
      <rect y="4.9" width="10" height="0.6" fill="rgba(14, 30, 46, 0.32)"></rect>
    </pattern>
    <pattern id="amman-flats" x="862" y="158" width="7" height="6.5" patternUnits="userSpaceOnUse">
      <rect width="3.6" height="3.4" fill="#7d8193"></rect>
    </pattern>
    <pattern id="amman-offices" x="1296" y="202" width="6.5" height="7" patternUnits="userSpaceOnUse">
      <rect width="3" height="3.6" fill="#808396"></rect>
    </pattern>
    <pattern id="amman-stone-floors" x="1014" y="104" width="10" height="7" patternUnits="userSpaceOnUse">
      <rect y="4" width="10" height="0.8" fill="rgba(110, 85, 70, 0.3)"></rect>
    </pattern>
    <pattern id="amman-podium" x="1150" y="240" width="10" height="7" patternUnits="userSpaceOnUse">
      <rect y="2" width="10" height="1.2" fill="rgba(200, 225, 235, 0.14)"></rect>
    </pattern>
    {
      windowStyles.map((s) => {
        const { stepX, stepY, ww, wh } = windowGrid(s);
        const frame = r1(0.6 * s.scale);
        return (
          <Fragment>
            <pattern id={`amman-win-${s.name}`} width={stepX} height={stepY} patternUnits="userSpaceOnUse">
              <rect width={ww} height={wh} fill={tone(WINDOW, s.haze)}></rect>
            </pattern>
            <pattern id={`amman-win-${s.name}-framed`} width={stepX} height={stepY} patternUnits="userSpaceOnUse">
              <rect width={ww} height={wh} fill={tone(FRAME, s.haze)}></rect>
              <rect x={frame} y={frame} width={r1(ww - 2 * frame)} height={r1(wh - 2 * frame)} fill={tone(WINDOW, s.haze)}></rect>
            </pattern>
            <pattern id={`amman-win-${s.name}-arched`} width={stepX} height={stepY} patternUnits="userSpaceOnUse">
              <path
                d={`M0 ${wh}V${r1(ww / 2)}A${r1(ww / 2)} ${r1(ww / 2)} 0 0 1 ${ww} ${r1(ww / 2)}V${wh}Z`}
                fill={tone(WINDOW, s.haze)}
              ></path>
              <rect x={r1(-0.3 * s.scale)} y={wh} width={r1(ww + 0.6 * s.scale)} height={r1(0.6 * s.scale)} fill={tone(ROOF, s.haze)}></rect>
            </pattern>
          </Fragment>
        );
      })
    }
    <!-- Faint courses of stone on the nearest walls -->
    <pattern id="amman-courses" width="12" height="2.8" patternUnits="userSpaceOnUse">
      <rect y="2.3" width="12" height="0.35" fill="rgba(120, 90, 70, 0.14)"></rect>
      <rect x="6" y="0.9" width="0.35" height="1.4" fill="rgba(120, 90, 70, 0.1)"></rect>
    </pattern>
    <linearGradient id="amman-low" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3c2c48" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#3c2c48" stop-opacity="0.38"></stop>
    </linearGradient>
    <linearGradient id="amman-street" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#070a14" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#070a14" stop-opacity="0.92"></stop>
    </linearGradient>
  </defs>

  <rect width={W} height={HORIZON_Y + 40} fill="url(#amman-sun)"></rect>
  {
    layers.map((l) => (
      <Fragment>
        {[...l.walls, ...l.paths].map(([fill, ds]) => <path fill={fill} d={ds.join('')} />)}
        {l.strokes.map((s) => <path d={s.d} fill="none" stroke={s.stroke} stroke-width={s.width} stroke-linecap="round" />)}
        {l.lights.map((w) => (
          <rect class:list={['lit', { fades: w.out < 70 }]} x={w.x} y={w.y} width={w.w} height={w.h} style={`--out:${w.out}%`} />
